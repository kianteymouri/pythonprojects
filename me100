import RPi.GPIO as GPIO
import time
import random
import threading
from time import strftime
from RPLCD.i2c import CharLCD

GPIO.setmode(GPIO.BCM)

# ------------------------
# LCD setup
# ------------------------
lcd = CharLCD('PCF8574', 0x27)

lcd_lock = threading.Lock()
stop_clock = threading.Event()
message_override = threading.Event()

# ------------------------
# Button pins
# ------------------------
GREEN_BTN = 17
YELLOW_BTN = 27
RED_BTN = 22

GPIO.setup(GREEN_BTN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(YELLOW_BTN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(RED_BTN, GPIO.IN, pull_up_down=GPIO.PUD_UP)

# ------------------------
# LED pins
# ------------------------
RED_LED = 23
YELLOW_LED = 24
GREEN_LED = 25

GPIO.setup(RED_LED, GPIO.OUT)
GPIO.setup(YELLOW_LED, GPIO.OUT)
GPIO.setup(GREEN_LED, GPIO.OUT)

# ------------------------
# Buzzer pin
# ------------------------
BUZZER = 26
GPIO.setup(BUZZER, GPIO.OUT)

# PWM object for buzzer
buzzer_pwm = GPIO.PWM(BUZZER, 200)

# ------------------------
# Notes
# ------------------------
C3=131; CS3=139; D3=147; DS3=156; E3=165; F3=175; FS3=185; G3=196; GS3=208; A3=220; AS3=233; B3=247
C4=262; CS4=277; D4=294; DS4=311; E4=330; F4=349; FS4=370; G4=392; GS4=415; A4=440; AS4=466; B4=494
C5=523; CS5=554; D5=587; DS5=622; E5=659; F5=698; FS5=740; G5=784; GS5=831; A5=880; AS5=932; B5=988
C6=1047

tune = [
    C4, E4, G4, C5, E5, G4, C5, E5,
    C4, E4, G4, C5, E5, G4, C5, E5,
    C4, D4, G4, D5, F5, G4, D5, F5,
    C4, D4, G4, D5, F5, G4, D5, F5,
    B3, D4, G4, D5, F5, G4, D5, F5,
    C4, E4, G4, C5, E5, G4, C5, E5
]

NOTE_DURATION = 0.18
NOTE_GAP = 0.03

# ------------------------
# Pattern settings
# ------------------------
PATTERN_LENGTH = 5
FLASH_ON_TIME = 0.5
FLASH_OFF_TIME = 0.25
DEBOUNCE_TIME = 0.2

LED_PINS = {
    "red": RED_LED,
    "yellow": YELLOW_LED,
    "green": GREEN_LED
}

BUTTON_PINS = {
    "red": RED_BTN,
    "yellow": YELLOW_BTN,
    "green": GREEN_BTN
}

COLORS = ["red", "yellow", "green"]

# ------------------------
# Thread control
# ------------------------
stop_music = threading.Event()


def lcd_show(line1="", line2=""):
    with lcd_lock:
        lcd.clear()
        lcd.cursor_pos = (0, 0)
        lcd.write_string(line1[:16].ljust(16))
        lcd.cursor_pos = (1, 0)
        lcd.write_string(line2[:16].ljust(16))


def lcd_show_temp(line1="", line2="", duration=1.5):
    message_override.set()
    lcd_show(line1, line2)
    time.sleep(duration)
    message_override.clear()


def clock_loop():
    while not stop_clock.is_set():
        if not message_override.is_set():
            now_date = strftime('%m/%d/%Y')
            now_time = strftime('%I:%M:%S %p')
            lcd_show(now_date, now_time)
        time.sleep(1)


def all_leds_off():
    GPIO.output(RED_LED, GPIO.LOW)
    GPIO.output(YELLOW_LED, GPIO.LOW)
    GPIO.output(GREEN_LED, GPIO.LOW)


def flash_led(color, on_time=FLASH_ON_TIME, off_time=FLASH_OFF_TIME):
    all_leds_off()
    GPIO.output(LED_PINS[color], GPIO.HIGH)
    time.sleep(on_time)
    GPIO.output(LED_PINS[color], GPIO.LOW)
    time.sleep(off_time)


def flash_all_leds(times=3, on_time=0.3, off_time=0.3):
    for _ in range(times):
        GPIO.output(RED_LED, GPIO.HIGH)
        GPIO.output(YELLOW_LED, GPIO.HIGH)
        GPIO.output(GREEN_LED, GPIO.HIGH)
        time.sleep(on_time)

        all_leds_off()
        time.sleep(off_time)


def generate_pattern(length):
    return [random.choice(COLORS) for _ in range(length)]


def show_pattern(pattern):
    print("\nWatch the pattern:")
    lcd_show_temp("Watch pattern", "", 1.0)
    time.sleep(0.5)

    for color in pattern:
        flash_led(color)

    print("Now repeat the pattern by pressing the buttons.")
    lcd_show_temp("Repeat pattern", "", 1.0)


def wait_for_button_press():
    while True:
        if GPIO.input(RED_BTN) == GPIO.LOW:
            while GPIO.input(RED_BTN) == GPIO.LOW:
                time.sleep(0.01)
            time.sleep(DEBOUNCE_TIME)
            return "red"

        if GPIO.input(YELLOW_BTN) == GPIO.LOW:
            while GPIO.input(YELLOW_BTN) == GPIO.LOW:
                time.sleep(0.01)
            time.sleep(DEBOUNCE_TIME)
            return "yellow"

        if GPIO.input(GREEN_BTN) == GPIO.LOW:
            while GPIO.input(GREEN_BTN) == GPIO.LOW:
                time.sleep(0.01)
            time.sleep(DEBOUNCE_TIME)
            return "green"

        time.sleep(0.01)


def get_user_pattern(length):
    entered = []
    print("Enter the pattern:")
    lcd_show_temp("Enter pattern", "", 1.0)

    for i in range(length):
        pressed = wait_for_button_press()
        entered.append(pressed)
        print(f"Button {i + 1}: {pressed}")

        GPIO.output(LED_PINS[pressed], GPIO.HIGH)
        time.sleep(0.15)
        GPIO.output(LED_PINS[pressed], GPIO.LOW)

    return entered


def play_note(freq, duration):
    buzzer_pwm.ChangeFrequency(freq)
    buzzer_pwm.start(50)
    time.sleep(duration)
    buzzer_pwm.stop()
    time.sleep(NOTE_GAP)


def music_loop():
    while not stop_music.is_set():
        for note in tune:
            if stop_music.is_set():
                break
            play_note(note, NOTE_DURATION)


try:
    # Start LCD clock thread
    clock_thread = threading.Thread(target=clock_loop, daemon=True)
    clock_thread.start()

    # Start music thread
    music_thread = threading.Thread(target=music_loop, daemon=True)
    music_thread.start()

    pattern = generate_pattern(PATTERN_LENGTH)

    while True:
        show_pattern(pattern)
        user_pattern = get_user_pattern(PATTERN_LENGTH)

        if user_pattern == pattern:
            print("\nCorrect!")
            lcd_show_temp("Correct!", "Good job", 2.0)
            stop_music.set()
            time.sleep(0.1)
            break
        else:
            print("\nIncorrect, try again.")
            lcd_show_temp("Incorrect", "Try again", 2.0)
            flash_all_leds(times=3)
            time.sleep(1)

finally:
    print("\nShutting down cleanly...")

    stop_music.set()
    stop_clock.set()
    time.sleep(0.1)

    try:
        buzzer_pwm.stop()
        del buzzer_pwm
    except:
        pass

    all_leds_off()
    GPIO.output(BUZZER, GPIO.LOW)

    with lcd_lock:
        lcd.clear()

    GPIO.cleanup()
